# Dedicated synthetic-data Supabase target; never use a production project.
LARA_MODE=demo
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# Operator only. Get the TLS pooler URI from Supabase Connect.
SUPABASE_OWNER_DATABASE_URL=
# Generated runtime and migrator connections are stored by provision-roles.mjs.
DATABASE_URL=
MIGRATION_DATABASE_URL=
WORKER_DATABASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
SUPABASE_PUBLISHABLE_KEY=
# Development sign-in prefill, written by `pnpm dev:account`; read only in demo and local modes.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
SESSION_SECRET_REF=local-file
SESSION_SECRET=
OBJECT_ADAPTER=filesystem
OBJECT_BUCKET=.local/uploads
OBJECT_REGION=local
MAIL_ADAPTER=local
EINVOICE_ADAPTER=fixture
AI_ADAPTER=fixture
OTEL_EXPORTER_OTLP_ENDPOINT=
DEMO_RESET_ENABLED=false
DEMO_DATABASE_CONFIRMED=false
RULE_PROFILE_ID=fixture-local

# Optional bounded rotation. Leave empty until an operator schedules rotation.
SESSION_PREVIOUS_SECRET=
SESSION_PREVIOUS_SECRET_REF=
SESSION_PREVIOUS_SECRET_EXPIRES_AT=

# P02 field encryption (32 bytes, hex or base64) for tax identifiers; supply from the secret manager.
FIELD_ENCRYPTION_KEY=

# P02 API runtime (optional). Limits are versioned configuration; raise only with capacity evidence.
RATE_LIMIT_READS_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
API_POOL_SIZE=10
SCANNER_ADAPTER=fixture
