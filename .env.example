# Runtime mode: local | demo | staging | production
LARA_MODE=local
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# Use local credentials for development. Never commit usable production values.
DATABASE_URL=postgresql://lara_api:change-me@localhost:5432/lara_local?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://lara_migrator:change-me@localhost:5432/lara_local?sslmode=disable
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET_REF=local-generated-secret
OBJECT_ADAPTER=filesystem
OBJECT_BUCKET=.local/uploads
OBJECT_REGION=local
MAIL_ADAPTER=local
EINVOICE_ADAPTER=disabled
AI_ADAPTER=fixture
OTEL_EXPORTER_OTLP_ENDPOINT=
DEMO_RESET_ENABLED=false
RULE_PROFILE_ID=fixture-local
