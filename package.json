{
  "name": "lara",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "assets:build": "node scripts/copy-brand-assets.mjs",
    "status:check": "node scripts/python.mjs scripts/build_status.py check",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm assets:build && pnpm --filter @lara/web build",
    "config:check": "node scripts/config-check.mjs",
    "api": "pnpm --filter @lara/api dev",
    "db:migrate": "pnpm --filter @lara/database migrate",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "release:check": "node scripts/release-check.mjs",
    "db:backup:snapshot": "node scripts/backup-snapshot.mjs",
    "db:restore:snapshot": "node scripts/restore-snapshot.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "setup": "node scripts/setup.mjs",
    "test:foundation": "node --test tests/foundation.test.mjs tests/identity.test.mjs tests/session-rotation.test.mjs tests/build-status-server.test.mjs tests/contracts.test.mjs tests/domain.test.mjs",
    "verify": "pnpm test:foundation && pnpm contracts:check && pnpm status:check && pnpm build",
    "test:isolation": "node scripts/test-subject-isolation.mjs",
    "dev:web": "pnpm --filter @lara/web dev",
    "test:restore": "node scripts/test-restore.mjs",
    "test:database": "node scripts/test-foundation-db.mjs",
    "test:e2e": "playwright test",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "status:serve": "node scripts/serve-build-status.mjs",
    "test:demo": "node scripts/test-demo-workflows.mjs",
    "test:p02-schema": "node scripts/test-p02-schema.mjs",
    "test:p02-domain": "node scripts/test-p02-domain.mjs",
    "test:p02-api": "node scripts/test-p02-api.mjs",
    "test:p02-load": "node scripts/test-p02-load.mjs",
    "test:p03-schema": "node scripts/test-p03-schema.mjs",
    "test:p04-schema": "node scripts/test-p04-schema.mjs",
    "test:p04-domain": "node scripts/test-p04-domain.mjs",
    "test:p04-api": "node scripts/test-p04-api.mjs",
    "test:p03-domain": "node scripts/test-p03-domain.mjs",
    "test:p03-api": "node scripts/test-p03-api.mjs",
    "test:p05-schema": "node scripts/test-p05-schema.mjs",
    "test:p05-domain": "node scripts/test-p05-domain.mjs",
    "test:p05-api": "node scripts/test-p05-api.mjs",
    "test:p06-schema": "node scripts/test-p06-schema.mjs",
    "test:p06-domain": "node scripts/test-p06-domain.mjs",
    "test:p06-api": "node scripts/test-p06-api.mjs",
    "test:p07-schema": "node scripts/test-p07-schema.mjs",
    "test:p07-domain": "node scripts/test-p07-domain.mjs",
    "test:p07-api": "node scripts/test-p07-api.mjs",
    "test:p08-schema": "node scripts/test-p08-schema.mjs",
    "test:p08-domain": "node scripts/test-p08-domain.mjs",
    "test:p08-api": "node scripts/test-p08-api.mjs",
    "test:p09-schema": "node scripts/test-p09-schema.mjs",
    "test:p09-domain": "node scripts/test-p09-domain.mjs",
    "test:p09-api": "node scripts/test-p09-api.mjs",
    "test:p10-schema": "node scripts/test-p10-schema.mjs",
    "test:p10-domain": "node scripts/test-p10-domain.mjs",
    "test:p10-api": "node scripts/test-p10-api.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.4"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
